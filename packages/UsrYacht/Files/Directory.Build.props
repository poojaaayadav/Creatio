		<Compile Include="$(PkgPath)/UsrYacht/Schemas/UsrYachtsStatus/UsrYachtsStatus.cs" Condition="Exists('$(PkgPath)/UsrYacht/Schemas/UsrYachtsStatus/UsrYachtsStatus.cs')" />
